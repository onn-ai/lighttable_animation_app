{
  "name": "lighttable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A minimalist, offline-first frame-by-frame rough animation light table.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "typecheck:core": "tsc -p tsconfig.core.json --pretty false",
    "typecheck:host": "tsc -p tsconfig.hostcheck.json --pretty false",
    "test:host": "tsc -p tsconfig.test.json --pretty false && node tests/run-host-tests.mjs",
    "build:coloring": "node plugins/coloring-mode/scripts/build.mjs",
    "test:coloring": "npm run build:coloring && node plugins/coloring-mode/scripts/test-setup.mjs && node --test plugins/coloring-mode/tests/**/*.test.mjs",
    "test:coloring:controller": "node --test plugins/coloring-mode/vendor/standalone-coloring-mode/tests/*.test.js",
    "test:schemas": "python3 tests/validate-schemas.py",
    "test": "npm run test:host && npm run test:schemas",
    "check": "npm run typecheck:core && npm run typecheck:host && npm test",
    "package:coloring": "npm --prefix plugins/coloring-mode run package",
    "test:plugins": "npm run test:coloring && npm run test:coloring:controller"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.8.3",
    "vite": "6.0.7"
  }
}
