{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@lighttable/plugin-sdk": ["contracts/plugin-api.d.ts"] },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "tests/stubs/react-shim.d.ts", "vite.config.ts"]
}
