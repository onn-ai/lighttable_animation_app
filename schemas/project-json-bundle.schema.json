{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lighttable.example/schemas/project-json-bundle-1.json",
  "title": "LightTable Single-file Project JSON Bundle v1",
  "type": "object",
  "required": ["format", "bundleVersion", "document", "embeddedAssets"],
  "properties": {
    "format": { "const": "lighttable.project-json-bundle" },
    "bundleVersion": { "const": 1 },
    "document": { "$ref": "project-1.0.0.json" },
    "embeddedAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mimeType", "byteLength", "sha256", "encoding", "data"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mimeType": { "type": "string", "minLength": 1 },
          "byteLength": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "encoding": { "const": "base64" },
          "data": { "type": "string", "contentEncoding": "base64" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
